# ==============================================================================
# AI Manager (9router Gateway) Configuration Template
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Server Network Settings
PORT=20129
HOST=0.0.0.0

# Local SQLite Database & 9router Core Directories
DB_PATH=./data/gateway.db
# Optional explicit directory for 9router Core data (machine-id & auth/cli-secret)
# NINEROUTER_DATA_DIR=./data/core

# 9router Core public base URL (used to build OAuth redirect_uri).
# Set to the public domain that serves 9router Core (never localhost in production).
BASE_URL=https://core.example.com
NEXT_PUBLIC_BASE_URL=https://core.example.com

# 9router Core feature flags (read at container runtime, not via settings API)
# ENABLE_TRANSLATOR=true

# Initial Admin Credentials (Seeded on first launch)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password_immediately

# Session & Security
SESSION_SECRET=generate_a_random_64_character_hex_secret_here

# Midtrans Payment Gateway (Optional - for automated token top-up)
MIDTRANS_SERVER_KEY=SB-Mid-server-your-key-here
MIDTRANS_CLIENT_KEY=SB-Mid-client-your-key-here
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_MERCHANT_ID=
